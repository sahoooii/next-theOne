generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// User = Authentication Login(System)
// Note: name String? ?を消す
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  image         String? //note: delete later
  accounts      Account[]
  member        Member?
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
}

enum SearchGender {
  MALE
  FEMALE
  NON_BINARY
  ANY
}

// Member = Profile in App(User of Domain)
model Member {
  id                String       @id @default(cuid())
  userId            String       @unique
  name              String
  gender            Gender
  searchGender      SearchGender @default(ANY)
  dateOfBirth       DateTime
  created           DateTime     @default(now())
  updated           DateTime     @default(now())
  description       String
  city              String
  country           String
  image             String?
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos            Photo[]
  sourceLikes       Like[]       @relation("source")
  targetLikes       Like[]       @relation("target")
  senderMessages    Message[]    @relation("sender")
  recipientMessages Message[]    @relation("recipient")
}

model Photo {
  id       String  @id @default(cuid())
  url      String
  publicId String?

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Like {
  sourceUserId String //いいねした人のID
  // sourceUserId は Member.userId を参照してる
  sourceMember Member @relation("source", fields: [sourceUserId], references: [userId], onDelete: Cascade)

  targetUserId String //いいねされた人のID
  targetMember Member @relation("target", fields: [targetUserId], references: [userId], onDelete: Cascade)

  // sourceUserId_targetUserId 複合キー用のユニーク識別子、同じペアは1つだけ
  @@id([sourceUserId, targetUserId])
}

model Message {
  id               String    @id @default(cuid())
  text             String
  created          DateTime  @default(now())
  senderId         String?
  recipientId      String?
  sender           Member?   @relation("sender", fields: [senderId], references: [userId], onDelete: SetNull)
  recipient        Member?   @relation("recipient", fields: [recipientId], references: [userId], onDelete: SetNull)
  dateRead         DateTime?
  senderDeleted    Boolean   @default(false)
  recipientDeleted Boolean   @default(false)
}
